{
    "name": "posthog.com",
    "description": "Official PostHog website.",
    "version": "1.0.0",
    "type": "module",
    "author": "PostHog",
    "license": "MIT",
    "engines": {
        "node": "22.x"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/PostHog/posthog.com"
    },
    "keywords": [
        "astro"
    ],
    "private": true,
    "scripts": {
        "prebuild": "pnpm generate-brand-assets",
        "build": "NODE_OPTIONS=--max-old-space-size=16384 astro build",
        "prebuild:minimal": "pnpm generate-brand-assets",
        "build:minimal": "MINIMAL_BUILD=true pnpm build",
        "start": "./bin/start",
        "serve": "astro preview",
        "format": "prettier --write \"**/*.{astro,html,js,jsx,mjs,cjs,ts,tsx,json,yml,css,scss}\"",
        "clean": "rm -rf dist .astro .cache/data-layer",
        "test": "echo \"Error: no test specified\" && exit 1",
        "typegen": "kea-typegen write .",
        "update-sprite": "svg-sprite -s --symbol-dest src/components/productFeature/images/icons --symbol-sprite sprited-icons.svg src/components/productFeature/images/icons/*.svg",
        "test-redirects": "jest scripts",
        "test:markdown": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/seo/turndownService.test.ts",
        "test:standard-site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/seo/standardSite.test.ts",
        "test:middleware": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test middleware.test.ts",
        "test:data-layer-utils": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/data-layer/utils.test.ts",
        "test:navs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/navs/activeMenu.test.ts src/navs/applicationMetrics.test.ts src/navs/applicationMetricsPresence.test.ts src/components/ReaderView/tabNavigation.test.ts src/components/PocketGuides/learnRoutes.test.ts",
        "test:sdk-references": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/components/SdkReferences/utils.test.ts",
        "check-links-post-build": "node scripts/check-links-post-build.cjs",
        "check-src-links": "node scripts/check-src-links.cjs",
        "check-product-changelogs": "node scripts/check-product-changelogs.cjs",
        "generate-md-redirects": "node scripts/generate-md-redirects.cjs",
        "generate-brand-assets": "node scripts/generate-brand-assets.mjs",
        "strapi-sync": "npx --yes tsx@4.20.6 scripts/run-post-build-tasks.ts strapi",
        "og-images": "npx --yes tsx@4.20.6 scripts/run-post-build-tasks.ts og",
        "postinstall": "patch-package",
        "prepare": "husky",
        "format:docs": "git diff --name-only --diff-filter=AM \"*.mdx\" \"*.md\" | xargs node scripts/fix-mdx.cjs",
        "vale": "vale",
        "vale:staged": "git diff --cached --name-only --diff-filter=AM -- '*.md' '*.mdx' | xargs vale",
        "vale:test": "vale .vale/test",
        "lint": "eslint .",
        "typecheck": "astro check"
    },
