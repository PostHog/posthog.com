{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "jsx": "react-jsx",
        "lib": ["dom", "dom.iterable", "esnext"],
        // Import roots, matching `alias` in astro.config.mjs.
        "paths": {
            "~/*": ["./src/*"],
            "@data/*": ["./.cache/data-layer/queries/*"],
            "lib/*": ["./src/lib/*"],
            "types": ["./src/types"],
            "types/*": ["./src/types/*"],
            "templates/*": ["./src/templates/*"],
            "images/*": ["./src/images/*"],
            "components/*": ["./src/components/*"],
            "constants/*": ["./src/constants/*"],
            "constants": ["./src/constants"],
            "logic/*": ["./src/logic/*"],
            "hooks/*": ["./src/hooks/*"],
            "docs/*": ["./.cache/posthog-main-repo/docs/*"],
            "onboarding/*": ["./.cache/posthog-main-repo/docs/onboarding/*"]
        },
        // Much of the codebase predates these; turning them on is a separate cleanup.
        "verbatimModuleSyntax": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "experimentalDecorators": true
    },
    "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*.ts", "astro.config.mjs", "middleware.ts"],
    "exclude": ["dist", "node_modules", "src/**/*.test.ts"]
}
