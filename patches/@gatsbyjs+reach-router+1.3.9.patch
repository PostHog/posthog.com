diff --git a/node_modules/@gatsbyjs/reach-router/es/lib/history.js b/node_modules/@gatsbyjs/reach-router/es/lib/history.js
index 8fb51a5..c9c42e0 100644
--- a/node_modules/@gatsbyjs/reach-router/es/lib/history.js
+++ b/node_modules/@gatsbyjs/reach-router/es/lib/history.js
@@ -18,8 +18,19 @@ var getLocation = function getLocation(source) {
     pathname = url.pathname;
   }
 
+  // patch-package: guard against malformed URLs (e.g. a bad percent-escape like
+  // "%ea" that is not valid UTF-8). decodeURI would otherwise throw "URI malformed"
+  // here at bootstrap and white-screen the whole app. Fall back to the raw pathname
+  // so the router can still render (and 404) the request.
+  var safePathname;
+  try {
+    safePathname = encodeURI(decodeURI(pathname));
+  } catch (e) {
+    safePathname = pathname;
+  }
+
   return {
-    pathname: encodeURI(decodeURI(pathname)),
+    pathname: safePathname,
     search: search,
     hash: hash,
     href: href,
