---
// Posts in contents/spotlight. Posts render templates/BlogPost.tsx.
// The section index and its tag pages come from src/views or src/pages/[folder]/[...tag].astro.
import PageIsland from '../../islands/PageIsland.astro'
import Site from '../../layouts/Site.astro'
import { postSectionPage, postSectionPaths, type PostSectionRoute } from '../../lib/content/posts'

export async function getStaticPaths() {
    return postSectionPaths('spotlight')
}

const page = postSectionPage(Astro.props as PostSectionRoute)
---

<Site>
    <PageIsland module={page.module} props={page.props} content={page.content} />
</Site>
